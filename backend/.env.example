# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/last_mile_tracker?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# SMTP (email notifications) — Brevo free-tier SMTP relay recommended,
# Gmail App Password works for local testing.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Last Mile Tracker <no-reply@example.com>"

# Seed admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!"
